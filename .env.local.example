# Supabaseプロジェクトの Settings > API から取得
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 任意：ログイン後のスモークテスト（e2e/authenticated.spec.ts）を実行する場合のみ設定。
# 実際にログイン可能な自分のアカウントの認証情報（データを変更する操作は行わない）。
# 未設定の場合、このテストは自動的にスキップされる。
E2E_EMAIL=
E2E_PASSWORD=
